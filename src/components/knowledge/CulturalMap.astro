---
/**
 * Cultural Map (PRD §22, design.md §59): navigator, bukan database UI.
 * SVG statis dengan <a> native — tanpa JavaScript. Garis pantai dari
 * Natural Earth 10m (lihat scripts/generate-map-data.mjs); wilayah budaya
 * digambar sebagai zona lunak "perkiraan sebaran" yang di-clip ke daratan,
 * BUKAN batas administratif (AGENTS.md §52). Daftar wilayah di bawahnya
 * adalah fallback + aksesibilitas.
 */
import { JAVA_VIEWBOX, LAND_PATH, REGION_AREAS } from "../../data/regions/map";
import { resolveEntryRoute } from "../../lib/content/routes";
import type { ContentObject } from "../../lib/content/types";

interface Props {
  regions: ContentObject[];
}

const { regions } = Astro.props;

const areas = REGION_AREAS.map((area) => {
  const region = regions.find((entry) => entry.id === area.id);
  if (!region) return undefined;
  return { ...area, region, href: resolveEntryRoute(region) };
}).filter((area): area is NonNullable<typeof area> => Boolean(area));
---

<figure class="cultural-map">
  <svg
    viewBox={`0 0 ${JAVA_VIEWBOX.width} ${JAVA_VIEWBOX.height}`}
    role="group"
    aria-label="Peta wilayah budaya Pulau Jawa dan Madura"
  >
    <title>Area menandai perkiraan sebaran wilayah budaya, bukan batas administratif</title>
    <defs>
      <clipPath id="cultural-map-land"><path d={LAND_PATH} /></clipPath>
      <filter id="cultural-map-soften" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="6"></feGaussianBlur>
      </filter>
    </defs>
    <path class="island" d={LAND_PATH} />
    {
      areas.map((area) => (
        <a href={area.href} class="area-link" aria-label={area.region.title}>
          <title>
            {area.region.title} — {area.region.shortDefinition}
          </title>
          <g clip-path="url(#cultural-map-land)">
            <g filter="url(#cultural-map-soften)">
              {area.paths.map((path) => (
                <path class="zone" d={path} />
              ))}
            </g>
          </g>
          <text class="marker-label" x={area.label.x} y={area.label.y} text-anchor="middle">
            {area.region.title}
          </text>
        </a>
      ))
    }
  </svg>

  <figcaption>
    Garis pantai: Natural Earth — area budaya bersifat perkiraan sebaran, bukan batas administratif.
  </figcaption>

  <ul class="map-list" aria-label="Daftar wilayah budaya">
    {
      areas.map((area) => (
        <li>
          <a href={area.href}>{area.region.title}</a>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .cultural-map svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .island {
    fill: var(--color-surface-soft);
    stroke: var(--border-default);
    stroke-width: 1.5;
  }

  .zone {
    fill: var(--color-brand);
    fill-opacity: 0.24;
    transition: fill-opacity var(--duration-fast) var(--ease-standard);
  }

  .marker-label {
    fill: var(--color-text);
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 500;
    pointer-events: none;
  }

  .area-link {
    outline: none;
  }

  .area-link:hover .zone,
  .area-link:focus-visible .zone {
    fill-opacity: 0.45;
  }

  .area-link:focus-visible .marker-label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .marker-label {
      font-size: 26px;
    }
  }

  figcaption {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .map-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .map-list a {
    color: var(--color-interactive);
    text-decoration: none;
  }

  .map-list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
