---
/**
 * "Lanjut dari sini" (design.md §41): mandatory pattern agar tidak ada
 * halaman dead-end (PRD §4.5). Diisi dari ranking related content.
 */
import TopicLink from "./TopicLink.astro";
import type { RelatedItem } from "../../lib/relations/related";

interface Props {
  items: RelatedItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="related-content" aria-label="Lanjut dari sini">
      <h2 class="heading">Lanjut dari sini</h2>
      <ul>
        {items.map((item) => (
          <li>
            <TopicLink entry={item.entry} />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related-content {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-6);
  }

  .heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
