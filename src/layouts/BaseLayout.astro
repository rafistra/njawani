---
import SearchOverlay from "../components/interactive/SearchOverlay";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** "index" = halaman konten diindeks Pagefind; default "ignore" (placeholder/landing). */
  pagefind?: "index" | "ignore";
}

const {
  title,
  description = "Njawani — platform pengetahuan Jawa: bahasa, sastra, dan budaya.",
  pagefind = "ignore",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);

const navItems = [
  { href: `${base}jelajah/`, label: "Jelajah" },
  { href: `${base}kawruh/`, label: "Kawruh" },
  { href: `${base}sinau/`, label: "Sinau" },
  { href: `${base}penanggalan/`, label: "Penanggalan" },
  { href: `${base}aksara/`, label: "Aksara" },
];

const drawerItems = [
  ...navItems,
  { href: `${base}daerah/`, label: "Daerah" },
  { href: `${base}cerita/`, label: "Cerita" },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Njawani" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&family=Plus+Jakarta+Sans:wght@400..700&family=Noto+Sans+Javanese:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-pagefind-ignore={pagefind === "ignore" ? true : undefined}>
    <a class="skip-link" href="#konten-utama">Langsung ke konten utama</a>
    <header class="site-header">
      <nav aria-label="Navigasi utama">
        <a class="wordmark" href={base}>Njawani</a>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
        <div class="nav-actions">
          <SearchOverlay client:idle basePath={base} />
          <button
            type="button"
            class="menu-button"
            aria-expanded="false"
            aria-controls="menu-drawer"
            data-menu-button
          >
            Menu
          </button>
        </div>
      </nav>
      <div class="menu-drawer" id="menu-drawer" hidden data-menu-drawer>
        <ul>
          {
            drawerItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>
    <main id="konten-utama">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Njawani — Menyelami Jawa, Memahami Rasa</p>
    </footer>
  </body>
</html>

<script>
  // Mobile navigation — Level 2: native JS (AGENTS.md §6).
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const drawer = document.querySelector<HTMLElement>("[data-menu-drawer]");

  button?.addEventListener("click", () => {
    const expanded = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!expanded));
    drawer?.toggleAttribute("hidden", expanded);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && drawer && !drawer.hidden) {
      drawer.setAttribute("hidden", "");
      button?.setAttribute("aria-expanded", "false");
      button?.focus();
    }
  });
</script>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: var(--space-2);
    z-index: 10;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--color-canvas);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav ul a {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  nav ul a:hover {
    color: var(--color-interactive);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .menu-button {
    display: none;
    padding: var(--space-1) var(--space-3);
    background: transparent;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .menu-drawer {
    border-top: 1px solid var(--border-subtle);
  }

  .menu-drawer ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-3) var(--space-5) var(--space-5);
    list-style: none;
  }

  .menu-drawer a {
    display: block;
    padding: var(--space-3) 0;
    color: var(--color-text);
    font-size: 1rem;
    text-decoration: none;
  }

  .menu-drawer a:hover {
    color: var(--color-interactive);
  }

  main {
    min-height: 60vh;
  }

  .site-footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-6) var(--space-5);
  }

  .site-footer p {
    max-width: var(--container-wide);
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  @media (max-width: 767px) {
    nav ul {
      display: none;
    }

    .menu-button {
      display: inline-block;
    }
  }
</style>
