---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/content/routes";
---

<BaseLayout title="Halaman tidak ditemukan — Njawani" description="Halaman yang kamu cari tidak tersedia.">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>Halaman tidak ditemukan.</h1>
    <p class="note">
      Alamat yang kamu buka tidak tersedia. Coba cari istilah lain, atau mulai
      dari Jelajah.
    </p>
    <ul class="links">
      <li><a href={withBase("/")}>Beranda</a></li>
      <li><a href={withBase("/kawruh/")}>Kawruh</a></li>
      <li><a href={withBase("/jelajah/")}>Jelajah</a></li>
      <li><a href={withBase("/cari/")}>Cari</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--container-reading);
    margin-inline: auto;
    padding: var(--space-10) var(--space-5);
  }

  .eyebrow {
    margin: 0;
    color: var(--color-brand);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
  }

  .note {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--color-interactive);
    text-decoration: none;
    border-bottom: 1px solid var(--border-default);
  }

  .links a:hover {
    border-bottom-color: var(--color-interactive);
  }
</style>
