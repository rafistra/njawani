---
/**
 * Template modul Sinau /sinau/{slug}/ (design.md §81): reading width,
 * struktur "yang akan dipahami → konsep → latihan → ringkasan →
 * pelajari selanjutnya". Tanpa XP, progress, atau badge.
 */
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import Breadcrumb from "../../components/knowledge/Breadcrumb.astro";
import CatatanRasa from "../../components/editorial/CatatanRasa.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadRegistry } from "../../lib/content";
import type { ContentObject } from "../../lib/content/types";

export async function getStaticPaths() {
  const registry = await loadRegistry();
  const rawModules = await getCollection("modules");
  const rawById = new Map(rawModules.map((raw) => [raw.id, raw]));

  return registry
    .getPublished()
    .filter((entry) => entry.type === "module")
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry, raw: rawById.get(entry.id)! },
    }));
}

interface Props {
  entry: ContentObject;
  raw: CollectionEntry<"modules">;
}

const { entry, raw } = Astro.props;
const registry = await loadRegistry();
const { Content } = await render(raw);
const readingTime = typeof entry.extra.reading_time === "number" ? entry.extra.reading_time : undefined;
---

<BaseLayout title={`${entry.title} — Njawani`} description={entry.shortDefinition} pagefind="index">
  <article class="module">
    <header class="module-header">
      <Breadcrumb
        items={[{ label: "Beranda", href: "/" }, { label: "Sinau", href: "/sinau/" }, { label: entry.title }]}
      />
      <p class="eyebrow" data-pagefind-filter="jenis" data-pagefind-meta="jenis">Modul Sinau</p>
      <h1 class="module-title" data-pagefind-weight="5">{entry.title}</h1>
      {entry.shortDefinition && (
        <p class="lead" data-pagefind-meta="definisi" data-pagefind-weight="3">{entry.shortDefinition}</p>
      )}
      <p class="meta">
        {readingTime ? `${readingTime} menit baca` : "Bacaan singkat"}
        {entry.themes.length > 0 && ` · ${entry.themes.join(", ")}`}
      </p>
    </header>

    <div class="module-body" data-pagefind-body>
      <Content />

      {entry.catatanRasa && <CatatanRasa text={entry.catatanRasa} />}
    </div>
  </article>
</BaseLayout>

<style>
  .module {
    max-width: var(--container-reading);
    margin-inline: auto;
    padding: var(--space-7) var(--space-5) var(--space-9);
  }

  .eyebrow {
    margin: var(--space-5) 0 0;
    color: var(--color-brand);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .module-title {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 4.5vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
  }

  .lead {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .meta {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .module-body {
    margin-top: var(--space-7);
  }

  /* Typografi modul — konsisten dengan entry body (design.md §15–16) */
  .module-body :global(h2) {
    margin: var(--space-7) 0 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .module-body :global(h2:first-child) {
    margin-top: 0;
  }

  .module-body :global(ul) {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
  }

  .module-body :global(li) {
    margin-top: var(--space-2);
    line-height: 1.625;
  }

  .module-body :global(p) {
    margin: var(--space-4) 0 0;
    line-height: 1.625;
  }

  .module-body :global(h2 + p),
  .module-body :global(h2 + ul) {
    margin-top: var(--space-3);
  }

  .module-body :global(em) {
    font-family: var(--font-display);
    font-size: 1.05em;
  }

  .module-body :global(a) {
    color: var(--color-interactive);
    text-decoration: underline;
    text-decoration-color: var(--border-default);
    text-underline-offset: 3px;
  }

  .module-body :global(a:hover) {
    text-decoration-color: var(--color-interactive);
  }
</style>
